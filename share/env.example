# SF Scanner — configuration
# Copy this file to .env and fill in your values.
# Place .env in the same directory as the sfscanner executable.

# Salesforce Connected App credentials
SF_CLIENT_ID=your_connected_app_client_id
SF_CLIENT_SECRET=your_connected_app_client_secret
SF_REDIRECT_URI=http://localhost:8080/auth/callback
SF_LOGIN_URL=https://login.salesforce.com

# AI provider — use one of the two options below

# Option A: Anthropic (direct)
ANTHROPIC_API_KEY=sk-ant-...

# Option B: Salesforce LLM Gateway (takes priority over Anthropic if set)
# LLMGW_API_KEY=your_llmgw_key
# LLMGW_BASE_URL=https://eng-ai-model-gateway.sfproxy.devx-preprod.aws-esvc1-useast2.aws.sfdc.cl/v1
# LLMGW_MODEL=gpt-5.6-sol

# Server settings
PORT=8080
SESSION_SECRET=change-this-to-a-long-random-string
