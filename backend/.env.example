SF_CLIENT_ID=your_connected_app_consumer_key
SF_CLIENT_SECRET=your_connected_app_consumer_secret
SF_REDIRECT_URI=http://localhost:8080/auth/callback
SF_LOGIN_URL=https://login.salesforce.com
SESSION_SECRET=change_this_to_a_random_secret_string

# Anthropic API (required for AI features)
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet-4-5-20250929

# Optional: custom Anthropic proxy
ANTHROPIC_BASE_URL=
ANTHROPIC_CUSTOM_HEADERS=

# Optional: OpenAI-compatible LLM gateway (takes priority over Anthropic when set)
LLMGW_API_KEY=
LLMGW_BASE_URL=https://api.openai.com/v1
LLMGW_MODEL=gpt-4o

# MCP server API key (set to any secret string to enable MCP tool access)
MCP_API_KEY=

FRONTEND_URL=http://localhost:8080
PORT=8080
